// Cloudflare Workers deploy settings (used by `npx wrangler deploy` in Workers Builds).
// The site is fully static: Cloudflare serves the built files from the folder below.
// "name" must match the Worker's name in the Cloudflare dashboard.
{
  "name": "embrace-evolve",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./sites/familieopstellingen/dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
