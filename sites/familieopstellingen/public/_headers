# Cloudflare response headers (Workers static assets / Pages both read this file).
# Built CSS/JS files have a content hash in their name, so they can be cached forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Photos rarely change; when one is replaced, give it a new file name.
/images/*
  Cache-Control: public, max-age=2592000

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
