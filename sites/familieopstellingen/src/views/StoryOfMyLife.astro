}[locale];

// Weekend dates (Saturday–Sunday). Keep in sync with the "Data" list in `prak` above.
const weekendDates = [['2027-04-24', '2027-04-25'], ['2027-06-26', '2027-06-27'], ['2027-09-11', '2027-09-12'], ['2027-10-30', '2027-10-31'], ['2028-01-15', '2028-01-16']];
const i = ids(Astro.site);
const pageUrl = abs(route('story', locale), Astro.site);
const course = {
  '@type': 'Course',
  '@id': `${pageUrl}#course`,
  name: 'The Story of my Life',
  alternateName: locale === 'nl' ? 'Schrijfopleiding: geef je levensverhaal vorm' : 'Writing course: give shape to your life story',
  description: copy.description,
  url: pageUrl,
  image: abs('/images/blog-voorbereiden.jpg', Astro.site),
  inLanguage: 'nl',
  provider: { '@id': i.business },
  about: ['Storytelling', locale === 'nl' ? 'Levensverhaal schrijven' : 'Life writing', 'Memoir', locale === 'nl' ? 'Scenario' : 'Screenwriting', locale === 'nl' ? 'Systemisch werk' : 'Systemic work'],
  teaches: copy.weekends.map((w) => `${w.h}: ${w.sub}`),
  audience: { '@type': 'Audience', audienceType: copy.voor.join('; ') },
  timeRequired: 'PT70H',
  offers: {
    '@type': 'Offer',
    category: 'Paid',
    price: '2450',
    priceCurrency: 'EUR',
    url: `${pageUrl}#inschrijven`,
    availability: 'https://schema.org/InStock',
    validFrom: '2026-11-01',
  },
  hasCourseInstance: {
    '@type': 'CourseInstance',
    courseMode: 'Onsite',
    startDate: weekendDates[0][0],
    endDate: weekendDates[4][1],
    location: { '@id': i.place },
    instructor: [{ '@id': i.gert }, { '@id': i.jessica }],
    maximumAttendeeCapacity: 12,
    courseSchedule: {
      '@type': 'Schedule',
      repeatFrequency: 'P2M',
      repeatCount: 5,
      startDate: weekendDates[0][0],
      endDate: weekendDates[4][1],
      scheduleTimezone: 'Europe/Brussels',
    },
    subEvent: weekendDates.map(([start, end], n) => ({
      '@type': 'Event',
      name: `The Story of my Life · ${copy.weekends[n].n}: ${copy.weekends[n].h}`,
      startDate: start,
      endDate: end,
      eventStatus: 'https://schema.org/EventScheduled',
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      location: { '@id': i.place },
      organizer: { '@id': i.business },
      performer: n === 1 ? [{ '@id': i.gert }, { '@id': i.jessica }] : [{ '@id': i.gert }],
    })),
  },
};
---
<Base locale={locale} title={copy.title} description={copy.description} routeKey="story" transparentNav ogImage="/images/blog-voorbereiden.jpg" ogImageAlt={copy.alt.hero}
  seoTitle={locale === 'nl' ? 'The Story of my Life · Schrijfopleiding in Brasschaat' : 'The Story of my Life · Writing course near Antwerp'}
  jsonLd={[course]}>
  <Hero image="/images/blog-voorbereiden.jpg" alt={copy.alt.hero} title={copy.title} subtitle={copy.heroSub} ctaLabel={copy.heroCta} ctaHref="#inschrijven" focus="center 45%" />

  <!-- Intro -->
  <section class="section">
    <div class="wrap split">
      <SectionHeading title={copy.introTitle} />
      <div class="stack">
        {copy.intro.map((p, i) => <p class:list={{ lede: i === 2 }}>{p}</p>)}
      </div>
    </div>
  </section>

  <!-- Herken je dit? -->
  <section class="section band">
    <div class="wrap wrap--narrow">
      <SectionHeading title={copy.herkenTitle} align="center" />
      <ul class="checks">
        {copy.herken.map((x) => <li>{x}</li>)}
      </ul>
      <p class="center lede herken-note">{copy.herkenNote}</p>
    </div>
  </section>

  <!-- Een leven is nog geen verhaal / vakmanschap & diepgang -->
  <section class="section">
    <div class="wrap grid grid--2 two">
      <article>
        <h2 class="display-sm">{copy.levenTitle}</h2>
        {copy.leven.map((p) => <p>{p}</p>)}
      </article>
      <article>
        <h2 class="display-sm">{copy.diepteTitle}</h2>
        {copy.diepte.map((p) => <p>{p}</p>)}
      </article>
    </div>
  </section>

  <!-- Vijf weekenden -->
  <section class="section band">
    <div class="wrap">
      <SectionHeading eyebrow={copy.reisEyebrow} title={copy.reisTitle} align="center" />
      <ol class="weekends">
        {copy.weekends.map((w) => (
          <li class="weekend">
            <div class="weekend__head">
              <p class="eyebrow">{w.n}</p>
              <h3 class="display-sm">{w.h}</h3>
              <p class="weekend__sub">{w.sub}</p>
            </div>
            <dl class="weekend__body">
              <div><dt class="eyebrow muted">{copy.focus}</dt><dd>{w.focus}</dd></div>
              <div><dt class="eyebrow muted">{copy.inhoud}</dt><dd>{w.body}</dd></div>
              {w.guest && <div class="weekend__guest"><dt class="eyebrow muted">{copy.coach}</dt><dd>{w.guest} <a class="arrow-link" href={route('over', locale)}>{copy.gertLink}</a></dd></div>}
            </dl>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Wat je ontvangt -->
  <section class="section">
    <div class="wrap">
      <SectionHeading title={copy.krijgTitle} align="center" />
      <div class="grid grid--3 krijg">
        {copy.krijg.map((x) => (<div><h3 class="display-sm">{x.h}</h3><p>{x.p}</p></div>))}
      </div>
      <blockquote class="quote measure">
        <p>“{copy.quote}”</p>
      </blockquote>
    </div>
  </section>

  <!-- Begeleider -->
  <section class="section band">
    <div class="wrap split split--gert">
      <div class="frame frame--3x4"><img src="/images/gert-portret-bril.jpg" alt={copy.alt.gert} loading="lazy" /></div>
      <div>
        <SectionHeading eyebrow={copy.gertEyebrow} title={copy.gertName} />
        <p class="gert-role">{copy.gertRole}</p>
        {copy.gert.map((p) => <p>{p}</p>)}
        <p><a class="arrow-link" href={route('over', locale)}>{copy.gertLink}</a></p>
      </div>
    </div>
  </section>

  <!-- Voor wie -->
  <section class="section">
    <div class="wrap split">
      <SectionHeading title={copy.voorTitle} />
      <ul class="checks">
        {copy.voor.map((x) => <li>{x}</li>)}
      </ul>
    </div>
  </section>

  <!-- Locatie -->
  <section class="section band">
    <div class="wrap split split--photo">
      <div>
        <SectionHeading eyebrow={copy.locEyebrow} title={copy.locTitle} />
        {copy.loc.map((p) => <p>{p}</p>)}
        <p><a class="arrow-link" href={route('locatie', locale)}>{copy.locLink}</a></p>
      </div>
      <div class="frame frame--4x3"><img src="/images/locatie-tuin.jpg" alt={copy.alt.loc} loading="lazy" /></div>
    </div>
  </section>

  <!-- Praktisch -->
  <section class="section">
    <div class="wrap split">
      <div>
        <SectionHeading eyebrow={copy.prakEyebrow} title={copy.prakTitle} />
        <p class="price"><span class="eyebrow">{copy.priceLabel}</span><span class="price__value">{copy.price}</span></p>
      </div>
      <dl class="facts">
        {copy.prak.map((x) => (
          <div>
            <dt class="eyebrow">{x.h}</dt>
            <dd>{x.list ? <ul class="dates">{x.list.map((d) => <li>{d}</li>)}</ul> : x.p}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Volgende stap + formulier -->
  <section class="section band" id="inschrijven">
    <div class="wrap">
      <SectionHeading title={copy.stapTitle} align="center" />
      <div class="grid grid--2 steps">
        {copy.stappen.map((s) => (
          <div class="step">
            <h3 class="display-sm">{s.h}</h3>
            <p>{s.p}</p>
            <a class="btn" href={`#formulier`} data-choice={s.value}>{s.h}</a>
          </div>
        ))}
      </div>
      <div class="wrap--narrow" id="formulier">
        <form class="form" name="the-story-of-my-life" method="POST" action={action} data-netlify={site.formEndpoint ? undefined : 'true'} netlify-honeypot="bot-field" accept-charset="UTF-8">
          <input type="hidden" name="form-name" value="the-story-of-my-life" />
          <input type="hidden" name="_next" value={thanks} />
          <input type="hidden" name="taal" value={locale} />
          <p class="visually-hidden"><label>Don’t fill this out: <input name="bot-field" /></label></p>
          <fieldset class="field fieldset">
            <legend>{copy.formChoice}</legend>
            {copy.stappen.map((s, i) => (
              <label class="radio"><input type="radio" name="keuze" value={s.value} checked={i === 0} /> {s.h}</label>
            ))}
          </fieldset>
          <div class="grid grid--2">
            <div class="field"><label for="sol-naam">{tr('form.name')} *</label><input id="sol-naam" name="naam" type="text" required autocomplete="name" /></div>
            <div class="field"><label for="sol-email">{tr('form.email')} *</label><input id="sol-email" name="email" type="email" required autocomplete="email" /></div>
          </div>
          <div class="field"><label for="sol-tel">{tr('form.phone')}</label><input id="sol-tel" name="telefoon" type="tel" autocomplete="tel" /></div>
          <div class="field"><label for="sol-project">{copy.formProject}</label><textarea id="sol-project" name="project"></textarea></div>
          <div class="field field--check"><input id="sol-consent" name="akkoord" type="checkbox" required value="ja" /><label for="sol-consent">{copy.formConsent}</label></div>
          <p><button class="btn btn--solid" type="submit">{copy.formSubmit}</button></p>
          <p class="small muted">{copy.formNote}</p>
        </form>
        {site.payments.story && (
          <div class="pay" id="betalen">
            <h3 class="display-sm">{copy.payTitle}</h3>
            <p>{copy.pay}</p>
            <p><a class="btn btn--solid" href={site.payments.story} rel="noopener">{copy.payBtn}</a></p>
            <p class="small muted">{copy.payMethods}</p>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Slotzin -->
  <section class="section band band--sand">
    <div class="wrap">
      <p class="display closing center measure">{copy.closing}</p>
    </div>
  </section>
</Base>

<style>
  .two { gap: clamp(1.5rem, 4vw, 4rem); }
  .two h2 { margin: 0 0 1rem; }
  .checks { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.9rem; }
  .checks li { position: relative; padding-left: 1.8rem; }
  .checks li::before { content: ''; position: absolute; left: 0; top: 0.75em; width: 1rem; height: 1px; background: var(--clay); }
  .herken-note { margin: 2.5rem auto 0; }
  .weekends { list-style: none; padding: 0; margin: 0; }
  .weekend { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: clamp(1rem, 4vw, 4rem); padding-block: 2rem; border-top: 1px solid var(--ink); }
  .weekend:last-child { border-bottom: 1px solid var(--ink); }
  .weekend__head h3 { margin: 0.5rem 0 0.3rem; }
  .weekend__sub { font-family: var(--font-display); font-style: italic; font-size: 1.2rem; margin: 0; }
  .weekend__body { margin: 0; display: grid; gap: 1rem; }
  .weekend__body dt { margin-bottom: 0.3rem; }
  .weekend__body dd { margin: 0; }
  .weekend__guest { border-left: 1px solid var(--clay); padding-left: 1rem; }
  .weekend__guest .arrow-link { display: inline-block; margin-top: 0.5rem; }
  .krijg { gap: clamp(1.5rem, 4vw, 3.5rem); }
  .krijg h3 { margin-bottom: 0.6rem; }
  .quote { margin: clamp(3rem, 6vw, 5rem) auto 0; text-align: center; }
  .quote p { font-family: var(--font-display); font-size: 1.5rem; line-height: 1.4; font-weight: 500; font-style: italic; }
  .split--photo { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); align-items: center; gap: clamp(2rem, 5vw, 5rem); }
  .split--gert { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: center; gap: clamp(2rem, 5vw, 5rem); }
  .gert-role { font-family: var(--font-display); font-style: italic; font-size: 1.3rem; margin-top: -0.5rem; }
  .price { display: grid; gap: 0.4rem; margin-top: 1rem; }
  .price__value { font-family: var(--font-display); font-size: 2.6rem; line-height: 1; }
  .facts { margin: 0; display: grid; gap: 1.5rem; }
  .facts dt { margin-bottom: 0.4rem; }
  .facts dd { margin: 0; }
  .dates { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.2rem; }
  .steps { gap: clamp(1.5rem, 4vw, 4rem); margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .step h3 { margin-bottom: 0.6rem; }
  .step p { margin-bottom: 1.2rem; }
  .form { display: grid; gap: 1.4rem; }
  .fieldset { border: 0; padding: 0; margin: 0; }
  .fieldset legend { font-size: var(--text-small); font-weight: 500; margin-bottom: 0.5rem; }
  .radio { display: flex; gap: 0.7em; align-items: start; padding: 0.3rem 0; font-size: var(--text-small); }
  .radio input { margin-top: 0.3em; }
  .pay { margin-top: clamp(2.5rem, 5vw, 3.5rem); padding-top: 2rem; border-top: 1px solid var(--ink); }
  .pay h3 { margin-bottom: 0.6rem; }
  .closing { font-size: clamp(1.6rem, 3vw, 2.4rem); line-height: 1.3; margin-inline: auto; }
  @media (max-width: 56rem) {
    .weekend, .split--photo, .split--gert { grid-template-columns: minmax(0, 1fr); }
  }
</style>
<script>
  // The two "next step" buttons preselect the matching choice in the form.
  document.querySelectorAll<HTMLAnchorElement>('[data-choice]').forEach((a) => {
    a.addEventListener('click', () => {
      const r = document.querySelector<HTMLInputElement>(`input[name="keuze"][value="${a.dataset.choice}"]`);
      if (r) r.checked = true;
    });
  });
</script>
