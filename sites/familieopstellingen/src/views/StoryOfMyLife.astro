---
/**
 * THE STORY OF MY LIFE — writing course in five weekends (formerly "Meesterlijk Schrijven").
 * Copy taken from the Pages document "Meesterlijk Schrijven"; English is a translation.
 * Layout: hero → intro → "herken je dit?" → two text sections → five weekends →
 * what you receive + quote → course leader (Gert) → for whom → location → practical facts → register / intro-call form.
 */
import Base from '../layouts/Base.astro';
import Hero from '@opstellingen/shared/components/Hero.astro';
import SectionHeading from '@opstellingen/shared/components/SectionHeading.astro';
import { site } from '../site.config';
import { t, route, type Locale } from '../i18n';
import { ids, abs } from '../lib/schema';

interface Props { locale: Locale }
const { locale } = Astro.props;
const tr = t(locale);
const thanks = new URL(route('bedankt', locale), Astro.site).toString();
const action = site.formEndpoint || route('bedankt', locale);

const copy = {
  nl: {
    title: 'The Story of my Life',
    description: 'Geef je levensverhaal vorm: een schrijfopleiding in vijf weekenden die storytellingtechniek combineert met systemisch werk, op Homecoming Land in Brasschaat, tussen Antwerpen en Breda.',
    heroSub: 'Geef je levensverhaal vorm · van herinnering naar meeslepend verhaal',
    heroCta: 'Schrijf je in',
    introTitle: 'De film van een uniek leven',
    intro: [
      'Veel mensen dromen ervan om hun leven vast te leggen in een boek of scenario. De film van een uniek leven. Een roman over hoogte- en dieptepunten, onverwachte wendingen, bijzondere relaties en verlies.',
      'Je ziet het verhaal voor je, maar de woorden komen niet. Na een paar bladzijden stokt het schrijven en verdwijnt je project in een lade. Of je schrijft veel, maar mist structuur, ritme of de impact die je voor ogen had.',
      'The Story of my Life helpt je om jouw persoonlijke ervaringen om te vormen tot een verhaal dat raakt — helder opgebouwd, eerlijk verteld en universeel herkenbaar.',
    ],
