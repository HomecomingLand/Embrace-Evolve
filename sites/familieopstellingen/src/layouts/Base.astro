---
/**
 * Base layout: <head>, fonts, nav, footer. Every page/view wraps itself in this.
 * Props: locale, title, description, alternates (language-switch links), transparentNav.
 */
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/cormorant-garamond/500-italic.css';
import '@fontsource/jost/400.css';
import '@fontsource/jost/500.css';
import '@fontsource/jost/600.css';
import '@opstellingen/shared/css/base.css';
import '../styles/theme.css';
import Nav from '@opstellingen/shared/components/Nav.astro';
import Footer from '@opstellingen/shared/components/Footer.astro';
import { site } from '../site.config';
import { baseGraph, breadcrumbs } from '../lib/schema';
import { t, route, type Locale, type RouteKey, localeLinks } from '../i18n';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  routeKey: RouteKey;
  slugs?: Partial<Record<Locale, string>>;
  transparentNav?: boolean;
  ogImage?: string;
  ogImageAlt?: string;
  /** Extra schema.org nodes for this page (Course, Event, BlogPosting, BreadcrumbList, ...). */
  jsonLd?: Record<string, unknown>[];
  /** Keep this page out of search results (thank-you pages, 404). */
  noindex?: boolean;
  /** Full <title> override (otherwise "Title · Familieopstellingen · Jessica Abicht", shortened if too long). */
  seoTitle?: string;
  /** Set for articles: published date (ISO). */
  published?: string;
}
const { locale, title, description, routeKey, slugs, transparentNav = false, ogImage = '/images/og-default.jpg', ogImageAlt, jsonLd = [], published } = Astro.props;
const noindex = Astro.props.noindex ?? routeKey === 'bedankt';
const tr = t(locale);
// Breadcrumbs: Home › (section ›) this page. Detail pages (slugs set) sit under their section.
const crumbs = routeKey === 'home' || noindex ? [] : [
  { name: 'Home', path: route('home', locale) },
  ...(slugs ? [{ name: tr(`nav.${routeKey}`), path: route(routeKey, locale) }] : []),
  { name: title, path: Astro.url.pathname },
];
const graph = {
  '@context': 'https://schema.org',
  '@graph': [...baseGraph(locale, Astro.site), ...(crumbs.length ? [breadcrumbs(crumbs, Astro.site)] : []), ...jsonLd],
};
const locales = localeLinks(locale, routeKey, slugs);
// hreflang only for real translations (a detail page without a twin links to nothing).
const hreflangs = slugs ? locales.filter((l) => l.code === locale || slugs[l.code]) : locales;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Google shows about 60 characters: keep the brand, drop parts that make it too long.
const fullTitle = Astro.props.seoTitle ?? (
  routeKey === 'home' ? title
  : `${title} · ${site.name} · ${site.person}`.length <= 62 ? `${title} · ${site.name} · ${site.person}`
  : `${title} · ${site.name}`.length <= 62 ? `${title} · ${site.name}`
  : title
);
const year = new Date().getFullYear();

const navItems = [
  { label: tr('nav.opstellingen'), href: route('opstellingen', locale) },
  { label: tr('nav.agenda'), href: route('agenda', locale) },
  { label: tr('nav.over'), href: route('over', locale) },
  { label: tr('nav.locatie'), href: route('locatie', locale) },
  { label: tr('nav.blog'), href: route('blog', locale) },
  { label: tr('nav.contact'), href: route('contact', locale) },
];
const footerColumns = [
  { title: tr('footer.pages'), links: [...navItems.slice(0, 3), { label: tr('nav.story'), href: route('story', locale) }] },
  { title: tr('footer.praktisch'), links: [navItems[3], navItems[4], { label: tr('nav.cta'), href: route('inschrijven', locale) }, { label: tr('footer.privacy'), href: route('privacy', locale) }] },
];
const addressLines = [site.address.venue, site.address.street, `${site.address.postal} ${site.address.city}`, locale === 'nl' ? site.address.country : site.address.countryEn];
const contactLines = [{ label: site.email, href: `mailto:${site.email}` }, { label: site.phone, href: site.phoneHref }];
const siblings = site.siblings.map((s) => ({ label: `${s.name} — ${locale === 'nl' ? s.nl : s.en}`, href: s.url }));
---
<!doctype html>
<html lang={locale === 'nl' ? 'nl' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <meta name="author" content={site.person} />
    {!noindex && hreflangs.map((l) => (<link rel="alternate" hreflang={l.code} href={new URL(l.href, Astro.site)} />))}
    {!noindex && hreflangs.some((l) => l.code === 'nl') && <link rel="alternate" hreflang="x-default" href={new URL(hreflangs.find((l) => l.code === 'nl')!.href, Astro.site)} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content={published ? 'article' : 'website'} />
    <meta property="og:site_name" content={`${site.name} · ${site.person}`} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:image:alt" content={ogImageAlt ?? title} />
    <meta property="og:locale" content={locale === 'nl' ? 'nl_BE' : 'en_GB'} />
    {(locale === 'nl' ? ['nl_NL', 'en_GB'] : ['nl_BE', 'nl_NL']).map((l) => <meta property="og:locale:alternate" content={l} />)}
    {published && <meta property="article:published_time" content={published} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    <meta name="theme-color" content="#f7f3ef" />
  </head>
  <body>
    <a class="skip" href="#main">{tr('skip')}</a>
    <Nav
      brand={site.name}
      brandHref={route('home', locale)}
      items={navItems}
      cta={{ label: tr('nav.cta'), href: route('inschrijven', locale) }}
      locales={locales}
      transparent={transparentNav}
      menuLabel={tr('nav.menu')}
      closeLabel={tr('nav.close')}
    />
    <main id="main">
      <slot />
    </main>
    <Footer
      brand={site.name}
      tagline={tr('footer.tagline')}
      columns={footerColumns}
      addressLines={addressLines}
      contactLines={contactLines}
      legal={tr('footer.legal', { year })}
      siblingsTitle={tr('footer.siblings')}
      siblings={siblings}
    />
  </body>
</html>

<style is:global>
  .skip { position: absolute; left: -999px; top: 0; background: var(--ink); color: var(--paper); padding: 0.6em 1em; z-index: 100; }
  .skip:focus { left: 1rem; top: 1rem; }
</style>
