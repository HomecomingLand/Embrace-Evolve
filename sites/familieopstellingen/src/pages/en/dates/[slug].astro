---
import { getCollection } from 'astro:content';
import EventDetail from '../../../views/EventDetail.astro';
export async function getStaticPaths() {
  const all = await getCollection('events', (e) => !e.data.draft);
  return all.filter((e) => e.data.lang === 'en').map((e) => {
    const other = all.find((x) => x.data.lang === 'nl' && x.data.key === e.data.key);
    return { params: { slug: e.id.split('/').pop() }, props: { event: e, slugs: { en: e.id.split('/').pop(), nl: other?.id.split('/').pop() } } };
  });
}
const { event, slugs } = Astro.props;
---
<EventDetail locale="en" event={event} slugs={slugs} />
